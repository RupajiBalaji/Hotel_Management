# HotelMind AI Environment Variables (Optional)
# If left blank, the app will run seamlessly with built-in multi-key rotating pool and offline fallback.

# Optional: Comma-separated Gemini API keys for AI agent responses & quota rotation
# VITE_GEMINI_API_KEYS=your_key_1,your_key_2,your_key_3

# Optional: Comma-separated fallback Gemini models
# VITE_GEMINI_MODELS=gemini-2.0-flash,gemini-1.5-flash,gemini-1.5-pro

# Port for Node Web Service (if running via server.js)
PORT=10000
